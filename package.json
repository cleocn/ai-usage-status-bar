{
  "name": "ai-usage-status-bar",
  "displayName": "AI Usage Status Bar for VS Code",
  "description": "Show GitHub Copilot, ChatGPT/Codex, Cursor, and Claude usage in the VS Code status bar",
  "version": "1.0.5",
  "publisher": "cleocn",
  "license": "MIT",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/cleocn/ai-usage-status-bar.git"
  },
  "engines": { "vscode": "^1.74.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "copilotUsage.refresh",
        "title": "Copilot Usage: Refresh"
      },
      {
        "command": "copilotUsage.signIn",
        "title": "Copilot Usage: Sign in to GitHub"
      },
      {
        "command": "aiUsage.openChatGPTUsage",
        "title": "AI Usage: Open ChatGPT Usage Page"
      },
      {
        "command": "aiUsage.refreshCursor",
        "title": "AI Usage: Refresh Cursor Usage"
      },
      {
        "command": "aiUsage.openClaudeUsage",
        "title": "AI Usage: Open Claude Usage Page"
      },
      {
        "command": "aiUsage.refreshClaude",
        "title": "AI Usage: Refresh Claude Usage"
      },
      {
        "command": "aiUsage.authenticateClaude",
        "title": "AI Usage: Authorize Claude (OAuth Login)"
      },
      {
        "command": "aiUsage.signOutClaude",
        "title": "AI Usage: Sign Out Claude"
      }
    ],
    "icons": {
      "cursor-logo": {
        "description": "Cursor Logo",
        "default": {
          "fontPath": "./resources/cursor-icons.woff",
          "fontCharacter": "\\E001"
        }
      }
    },
    "configuration": {
      "title": "AI Usage Status Bar",
      "properties": {
        "aiUsage.style": {
          "type": "string",
          "enum": ["minimal", "verbose"],
          "enumDescriptions": ["仅显示图标和数字", "同时显示服务商名称"],
          "default": "minimal",
          "description": "状态栏显示风格"
        },
        "aiUsage.providers.copilot": {
          "type": "boolean",
          "default": true,
          "description": "在状态栏显示 GitHub Copilot 用量"
        },
        "aiUsage.providers.chatgpt": {
          "type": "boolean",
          "default": true,
          "description": "在状态栏显示 ChatGPT 订阅信息"
        },
        "aiUsage.providers.cursor": {
          "type": "boolean",
          "default": true,
          "description": "在状态栏显示 Cursor 用量"
        },
        "aiUsage.providers.claude": {
          "type": "boolean",
          "default": true,
          "description": "在状态栏显示 Claude 用量"
        },
        "aiUsage.claude.oauthToken": {
          "type": "string",
          "default": "",
          "description": "Claude OAuth token（可选；优先于环境变量 ANTHROPIC_OAUTH_TOKEN / CLAUDE_OAUTH_TOKEN）"
        }
      }
    }
  }
}
